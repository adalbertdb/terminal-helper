#!/usr/bin/env bash
# tbtw — pregúntale a Claude Haiku sobre lo que hay en tu terminal (estilo /btw).
# foot lo llama con la pantalla por stdin; abre un popup flotante para preguntar.
set -u
SNAP="${XDG_RUNTIME_DIR:-/tmp}/tbtw.txt"
MODEL="${TBTW_MODEL:-haiku}"
LINES_CTX="${TBTW_LINES:-150}"

if [ "${1:-}" != "--ask" ]; then
  tail -n "$LINES_CTX" >"$SNAP"
  omarchy-cmd-terminal-cwd >"$SNAP.cwd" 2>/dev/null  # directorio de la terminal original
  hyprctl activewindow -j | sed -n 's/.*"address": "\(.*\)".*/\1/p' >"$SNAP.win"  # ventana a la que volver
  # ponytail: un popup a la vez; el nuevo reemplaza al anterior
  pkill -f 'app-id=tbtw' 2>/dev/null
  setsid -f foot --app-id=tbtw "$0" --ask >/dev/null 2>&1
  exit 0
fi

SYS='You are a terminal assistant. You receive the cwd, its file listing and the recent contents of the user'\''s terminal (a shell or a REPL such as python), plus what they want to do. Reply ONLY with the command or line of code that does it, as a single line: no markdown, code fences or explanation. The command may be long, complex or chained (&&, ;, pipes, subshells); to run several steps in a shell, chain them on one line. To start a REPL with setup, use one line like: python3 -i -c "import pandas as pd; df = pd.read_csv('\''file.csv'\'')". Use real file names from the listing. If already inside a REPL, reply with a line for that REPL. The request may be in any language.'
cd "${XDG_RUNTIME_DIR:-/tmp}" || exit 1   # fuera de proyectos: sin CLAUDE.md que gaste tokens
read -r -e -p $'\e[1;35m? \e[0m' q && [ -n "$q" ] || exit 0
echo -n "..."
cmd=$({ d=$(cat "$SNAP.cwd" 2>/dev/null); echo "<cwd>$d</cwd>"; echo '<files>'; ls -1 -- "$d" 2>/dev/null | head -50; echo '</files>'; echo '<terminal>'; cat "$SNAP"; echo '</terminal>'; echo "Quiero: $q"; } |
  claude -p --model "$MODEL" --tools "" --no-session-persistence \
    --setting-sources "" --system-prompt "$SYS" |
  sed -e '/^```/d' -e 's/^[$>]\+ //' | head -n1)
[ -n "$cmd" ] || { echo " sin respuesta"; read -r -n1; exit 1; }
wl-copy -- "$cmd"
# se escribe en la ventana que recupera el foco al cerrar el popup; sin Enter
setsid -f sh -c 'sleep 0.2; hyprctl dispatch focuswindow "address:$(cat "$2.win")"; sleep 0.2; wtype -- "$1"' _ "$cmd" "$SNAP" >"$SNAP.log" 2>&1
